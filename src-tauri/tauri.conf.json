{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-hud",
  "version": "0.2.0",
  "identifier": "com.akhil.git-hud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "git-hud",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A lightweight, high-performance local-first Git HUD",
    "longDescription": "git-hud is a desktop Git GUI: a 60fps commit canvas, conflict editor, stage/commit, an integrated terminal, and collaboration insights — all local-first via libgit2.",
    "copyright": "© 2026 git-hud contributors (MIT)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
